@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Điện Thoại - Máy Tính Bảng</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <link rel="stylesheet" href="~/StyleSheet1.css" />

</head>
<body>
    <header class="top-header">
        <div class="container header-row">
            <div class="logo>
                <span class="logo-main">TIKI</span>
                <span class="logo-sub">Tốt & Nhanh</span>
            </div>
            <div class="search-box">
                <input type="text"
                       placeholder="Tìm kiếm sản phẩm, thương hiệu, mã sản phẩm,..." />
                <button>
                    <i class="fas fa-search"></i>
                    Tìm Kiếm
                </button>
            </div>
            <div class="header-actions">
                <div> <i class="fas fa-shopping-cart"></i></div>
                <span>Giỏ Hàng</span>
            </div>
        </div>

        <div class="container quick-links">
            <span>Cam kết 100% hàng thật</span>
            <span>Hoàn 200% nếu hàng giả</span>
            <span>30 ngày đổi trả</span>
            <span>Giao nhanh 2h</span>
            <span>Giá siêu rẻ</span>
            <span>Freeship mọi nơi</span>
        </div>
    </header>
    <main class="container">
        <div class="breadcrumb">
            Trang Chủ
            <i class="fas fa-chevron-right"></i>
            Điện Thoại - Máy Tính Bảng
        </div>
        <div class="layout">
            <aside class="sidebar">
                <h3>Khám phá theo danh mục</h3>
                <ul>
                    <li>Điện thoại Smartphone</li>
                    <li>Máy tính bảng</li>
                    <li>Máy đọc sách</li>
                    <li>Điện thoại phổ thông</li>
                    <li>Điện thoại bàn</li>
                </ul>

                <h3>Thương Hiệu</h3>
                <label>
                    <input type="checkbox" />
                    Apple
                </label>
                <label>
                    <input type="checkbox" />
                    Samsung
                </label>
                <label>
                    <input type="checkbox" />
                    Xiaomi
                </label>
                <label>
                    <input type="checkbox" />
                    OPPO
                </label>
                <label>
                    <input type="checkbox" />
                    Vivo
                </label>

                <h3>
                    Mức Giá
                </h3>
                <label>
                    <input type="checkbox" />
                    Dưới 5 triệu
                </label>
                <label>
                    <input type="checkbox" />
                    5 - 10 triệu
                </label>
                <label>
                    <input type="checkbox" />
                    10 - 20 triệu
                </label>
                <label>
                    <input type="checkbox" />
                    Trên 20 triệu
                </label>
            </aside>

            <section class="content">
                <h1>Điện Thoại - Máy Tính Bảng</h1>
                <div class="banner"></div>
                <small>MỞ BÁN CHÍNH THỨC</small>
                <h2>IPHONE 16 Series</h2>
                <p>Trải nghiệm công nghệ mới nhất</p>
                <button>Xem Ngay</button>
              </div>
                <div class="phone-banner">
             <i class="fab fa-apple"></i>
             <strong>iPhone 16 Pro Max</strong>
                </div>

        <div class="categories">
            <div class="category">
                <div class="cat-icon">
                    <i class="fas fa-mobile-alt"></i>
                </div>
                <span>Điện thoại Smartphone</span>
            </div>
            <div class="category">
                <div class="cat-icon">
                    <i class="fas fa-tablet-alt"></i>
                </div>
                <span>Máy tính bảng</span>
            </div>
            <div class="category">
                <div class="cat-icon">
                    <i class="fas fa-book"></i>
                </div>
                <span>Máy đọc sách</span>
            </div>
            <div class="category">
                <div class="cat-icon">
                    <i class="fas fa-phone"></i>
                </div>
                <span>Điện thoại phổ thông</span>
            </div>
            <div class="category">
                <div class="cat-icon">
                    <i class="fas fa-phone-volume"></i>
                </div>
                <span>Điện thoại bàn</span>
            </div>
        </div>

        <div class="filter-row">
            <button class="active">
                Phổ biến
            </button>
            <button>Bán Chạy</button>
            <button>Giá Thấp</button>
            <button>Giá Cao</button>
            <select>
                <option>Tất cả</option>
                <option>Apple</option>
                <option>Samsung</option>
                <option>Xiaomi</option>
            </select>
        </div>

        <div class="products">
            <article class="products-card">
                <div class="badge">TIKI TRADING</div>
                <div class="product-image iphone-dark">
                    <i class="fab fa-apple"></i>
                </div>
                <h3> Apple iPhone 16 Pro Max - Titan Tự Nhiên - 256GB</h3>
                <div class="rating">
                    ★★★★★
                    <span>(128)</span>
                </div>

                <div class="price">
                    40.990.000đ
                </div>

                <div class="installment">
                    Trả góp 0%
                </div>
            </article>
        </div>
        <article class="product-card">

            <div class="badge">
                TIKI TRADING
            </div>

            <div class="product-image iphone-dark second">

                <i class="fab fa-apple"></i>

            </div>

            <h3>
                Apple iPhone 16 Pro -
                Titan Tự Nhiên - 128GB
            </h3>

            <div class="rating">
                ★★★★★
                <span>(95)</span>
            </div>

            <div class="price">
                31.990.000đ
            </div>

            <div class="installment">
                Trả góp 0%
            </div>

        </article>


        <article class="product-card">

            <div class="badge">
                TIKI TRADING
            </div>

            <div class="product-image iphone-green">

                <i class="fab fa-apple"></i>

            </div>

            <h3>
                Apple iPhone 16 -
                Xanh Mòng Két - 256GB
            </h3>

            <div class="rating">
                ★★★★★
                <span>(76)</span>
            </div>

            <div class="price">
                25.990.000đ
            </div>

            <div class="installment">
                Trả góp 0%
            </div>

        </article>


        <article class="product-card">

            <div class="badge">TIKI TRADING </div>
            <div class="product-image iphone-blue">
                <i class="fab fa-apple"></i>
            </div>
            <h3>Apple iPhone 16 Plus 128GB</h3>
            <div class="rating">
                ★★★★★
                <span>(63)</span>
            </div>
            <div class="price">28.990.000đ</div>
            <div class="installment">Trả góp 0%</div>
        </article>

          <article class="product-card">
            <div class="badge">NEW</div>
            <div class="product-image iphone-pink">
                <i class="fab fa-apple"></i>
            </div>
            <h3>Apple iPhone 15 Hồng 128GB</h3>
            <div class="rating">
                ★★★★★
                <span>(52)</span>
            </div>
            <div class="price">18.990.000đ</div>
            <div class="installment">Trả góp 0%</div>
            </article>
          </section>
        </div>
</main>
</body>
</html>
